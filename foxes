#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/utils.sh"
source "$SCRIPT_DIR/lib/session-info.sh"
source "$SCRIPT_DIR/lib/save.sh"
source "$SCRIPT_DIR/lib/restore.sh"
source "$SCRIPT_DIR/lib/list.sh"

require_dependencies

mkdir -p "$BACKUP_DIR"

case "${1:-}" in
  save)
    save_session "${2:-}"
    ;;
  list)
    list_sessions
    ;;
  restore)
    if [[ "${2:-}" != "-n" ]]; then
      echo "usage: firefox-session restore -n NUMBER"
      exit 1
    fi
    restore_session "${3:-}"
    ;;
  -n|--number)
    restore_session "${2:-}"
    ;;
  "")
    select_session
    ;;
  *)
    echo "usage:"
    echo "  firefox-session save [session-name]  # сохранить (с названием)"
    echo "  firefox-session                      # интерактивный выбор"
    echo "  firefox-session list                 # список сессий"
    echo "  firefox-session -n NUMBER            # восстановить по номеру"
    echo "  firefox-session restore -n NUMBER    # восстановить по номеру"
    exit 1
    ;;
esac
